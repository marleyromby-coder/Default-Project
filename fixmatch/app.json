{
  "expo": {
    "name": "FixMatch",
    "slug": "fixmatch",
    "version": "1.0.0",
    "description": "Find and compare tradespeople and mechanics on price, distance and Trustpilot reviews – and call them directly. Danish and English.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fixmatch",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#1F4A3A",
    "backgroundColor": "#F4F1EA",
    "ios": {
      "bundleIdentifier": "dk.fixmatch.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/fixmatch.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "dk.fixmatch.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1F4A3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "FixMatch",
      "shortName": "FixMatch",
      "lang": "da",
      "themeColor": "#F4F1EA",
      "backgroundColor": "#F4F1EA"
    },
    "locales": {
      "da": "./locales/da.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#11130F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FixMatch uses your location while the app is open to show tradespeople and garages near you and work out the distance to them. Your location stays on your phone.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "da",
              "en"
            ],
            "android": [
              "da",
              "en"
            ]
          },
          "supportsRTL": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "dk.fixmatch.app.widgets",
          "groupIdentifier": "group.dk.fixmatch.app",
          "widgets": [
            {
              "name": "FixMatchQuickHelp",
              "displayName": "Hurtig hjælp",
              "description": "Beskriv dit problem, eller find VVS, el, låsesmed og mekaniker med ét tryk.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "src/widgets/quick-help.tsx"
              }
            },
            {
              "name": "FixMatchSaved",
              "displayName": "Gemte håndværkere",
              "description": "Dine gemte håndværkere, og om de har åbent lige nu.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "src/widgets/saved.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
