# FixMatch's Supabase project in the EU. Copy this file to .env and fill in the two values
# from Supabase → Project Settings → API Keys (see docs/lancering/supabase.md).
# The publishable key is meant to be in the app. Never put the secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
