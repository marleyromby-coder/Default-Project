{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "simulator": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_FIXMATCH_DATA": "demo"
      },
      "ios": {
        "simulator": true
      }
    },
    "demo": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_FIXMATCH_DATA": "demo"
      },
      "ios": {
        "simulator": false
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_FIXMATCH_DATA": "demo",
        "EXPO_PUBLIC_FIXMATCH_TRUSTPILOT": "off"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_FIXMATCH_DATA": "live",
        "EXPO_PUBLIC_FIXMATCH_TRUSTPILOT": "off"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {}
    },
    "production": {
      "ios": {}
    }
  }
}
